# Copia este archivo a .env y ajusta los valores para tu entorno.
# No commits credenciales reales.

SPRING_PROFILES_ACTIVE=dev

DB_NAME=bankos
DB_USERNAME=bankos
DB_PASSWORD=bankos
DB_PORT=5432

REDIS_PORT=6379

APP_PORT=8080

# En producción genera un secreto aleatorio de al menos 32 bytes.
JWT_SECRET=change-me-in-production-0123456789abcdef0123456789abcdef
JWT_ISSUER=bankos
JWT_EXPIRATION_MS=3600000

CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

WEBHOOK_DISPATCH_INTERVAL_MS=5000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=5000
